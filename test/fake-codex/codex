#!/usr/bin/env node
import { writeFileSync, appendFileSync } from 'node:fs';
import { spawn } from 'node:child_process';
const args = process.argv.slice(2);
if (args.includes('--fake-descendant')) {
  if (process.env.FAKE_CODEX_PIDS_FILE) appendFileSync(process.env.FAKE_CODEX_PIDS_FILE, `${process.pid}\n`);
  process.on('SIGTERM', () => {});
  setTimeout(() => process.exit(0), 15000);
} else {
  if (process.env.FAKE_CODEX_ENV_FILE) writeFileSync(process.env.FAKE_CODEX_ENV_FILE, JSON.stringify({ FODH_PROJECT_ROOT: process.env.FODH_PROJECT_ROOT, FODH_CODEX_CHILD: process.env.FODH_CODEX_CHILD }));
  if (process.env.FAKE_CODEX_ARGS_FILE) writeFileSync(process.env.FAKE_CODEX_ARGS_FILE, JSON.stringify(args));
  let prompt = ''; for await (const chunk of process.stdin) prompt += chunk;
  if (process.env.FAKE_CODEX_STDIN_FILE) writeFileSync(process.env.FAKE_CODEX_STDIN_FILE, prompt);
  if (process.env.FAKE_CODEX_PIDS_FILE) appendFileSync(process.env.FAKE_CODEX_PIDS_FILE, `${process.pid}\n`);
  if (process.env.FAKE_CODEX_DESCENDANT) spawn(process.execPath, [import.meta.filename, '--fake-descendant'], { stdio: 'ignore' });
  if (process.env.FAKE_CODEX_DETACHED_CHILD === '1' || process.env.FAKE_CODEX_BACKGROUND_TOOL === '1') {
    const tool = spawn('/usr/bin/perl', ['-MPOSIX', '-e', 'POSIX::setsid(); open(my $fh, ">", $ENV{FAKE_CODEX_DETACHED_FILE}) or die; print $fh "$$"; close $fh; exec "sleep","60"'], { stdio: 'ignore' });
    if (process.env.FAKE_CODEX_BACKGROUND_TOOL === '1') tool.unref();
  }
  const thread = args[1] === 'resume' ? args[2] : `t-fake-${process.pid}`;
  const emit = value => process.stdout.write(JSON.stringify(value) + '\n');
  emit({ type: 'thread.started', thread_id: thread }); emit({ type: 'turn.started' });
  await new Promise(ok => setTimeout(ok, Number(process.env.FAKE_CODEX_SLEEP_MS ?? (process.env.FAKE_CODEX_BACKGROUND_TOOL === '1' ? 31000 : 0))));
  const message = '## 결과\n변경: src/example.ts\n검증: 1 passed\n미완: 없음';
  emit({ type: 'item.completed', item: { id: 'message', type: 'agent_message', text: message } });
  emit({ type: 'item.completed', item: { id: 'files', type: 'file_change', changes: [{ path: 'src/example.ts', kind: 'update' }] } });
  emit({ type: 'item.started', item: { id: 'cmd', type: 'command_execution', command: 'fake test' } });
  emit({ type: 'item.completed', item: { id: 'cmd', type: 'command_execution', exit_code: 0 } });
  emit({ type: 'item.completed', item: { type: 'error', message: 'Under-development warning' } });
  emit({ type: 'item.completed', item: { type: 'error', message: 'Skill descriptions warning' } });
  emit({ type: 'turn.completed', usage: { input_tokens: 10, output_tokens: 20 } });
  if (args.includes('-o')) writeFileSync(args[args.indexOf('-o') + 1], message);
  process.exitCode = Number(process.env.FAKE_CODEX_EXIT ?? 0);
}
