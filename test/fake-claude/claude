#!/usr/bin/env node
import { readFileSync, appendFileSync, mkdirSync, writeFileSync } from 'node:fs';
import { spawn, spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
const args = process.argv.slice(2);
const self = fileURLToPath(import.meta.url);
const recordPid = () => {
  mkdirSync('.pi', { recursive: true });
  appendFileSync('.pi/fake-pids.jsonl', JSON.stringify({ pid: process.pid }) + '\n');
};
if (args.includes('--hang-orphan-child')) {
  recordPid(); setTimeout(() => process.exit(0), 60000);
} else if (args.includes('--hang-child') || args.includes('--hang-grandchild')) {
  recordPid();
  if (args.includes('--hang-child')) spawn(process.execPath, [self, '--hang-grandchild'], { stdio: 'ignore' });
  if (process.env.FAKE_CLAUDE_SCENARIO === 'hang-stubborn') process.on('SIGTERM', () => {});
  setInterval(() => {}, 1000);
} else {
  const scenario = process.env.FAKE_CLAUDE_SCENARIO ?? 'first';
  if (!args.includes('--verbose') || scenario === 'no-verbose') {
    process.stderr.write('Error: When using --print, --output-format=stream-json requires --verbose\n'); process.exit(1);
  }
  const get = flag => args[args.indexOf(flag) + 1];
  const resume = args.includes('--resume');
  const sid = get(resume ? '--resume' : '--session-id');
  if (!sid || (scenario === 'resume' && !resume) || (process.env.FAKE_EXPECT_SID && process.env.FAKE_EXPECT_SID !== sid)) {
    process.stderr.write('세션 인자가 일치하지 않습니다.\n'); process.exit(1);
  }
  let prompt = ''; for await (const chunk of process.stdin) prompt += chunk;
  mkdirSync('.pi', { recursive: true });
  const stripped = ['CLAUDECODE', 'CLAUDE_CODE_ENTRYPOINT', 'ANTHROPIC_API_KEY', 'ANTHROPIC_AUTH_TOKEN',
    'ANTHROPIC_BASE_URL', 'CLAUDE_CODE_USE_BEDROCK', 'CLAUDE_CODE_USE_VERTEX', 'CLAUDE_CODE_USE_FOUNDRY'];
  appendFileSync('.pi/fake-calls.jsonl', JSON.stringify({
    args, prompt, projectRoot: process.env.FODH_PROJECT_ROOT, brain: process.env.FODH_BRAIN, docsRoot: process.env.FODH_DOCS_ROOT, protectedExtra: process.env.FODH_PROTECTED_EXTRA, forbiddenEnvPresent: stripped.filter(key => key in process.env),
  }) + '\n');
  const fixtureName = scenario === 'resume' ? 'resume-run' : 'first-run-hook-deny';
  const path = new URL(`../fixtures/claude-stream-json/${fixtureName}.jsonl`, import.meta.url);
  const events = readFileSync(path, 'utf8').trim().split('\n').map(line => JSON.parse(line));
  const emit = event => {
    if (event.subtype === 'init' && scenario.startsWith('p5-skills-')) event = { ...event,
      skills: scenario !== 'p5-skills-missing' ? ['fodh-workflow', 'fodh-spec-writing', 'fodh-review-checklist', 'fodh-judgment'] : [],
      memory_paths: scenario === 'p5-skills-missing' ? [] : { auto: process.cwd() + '/auto-memory' },
    };
    if (['fable', 'opus'].includes(get('--model')) || get('--model')?.startsWith('claude-')) {
      const requested = get('--model');
      const model = requested === 'fable' ? 'claude-fable-5-1' : requested === 'opus' ? 'claude-opus-5-5' : requested;
      if (event.subtype === 'init') event = { ...event, model };
      if (event.type === 'result') {
        const usage = Object.values(event.modelUsage ?? {}).at(-1) ?? event.usage ?? {};
        event = { ...event, modelUsage: { [model]: usage } };
      }
    }
    if (scenario === 'api-key' && event.subtype === 'init') event = { ...event, apiKeySource: 'ANTHROPIC_API_KEY' };
    process.stdout.write(JSON.stringify({ ...event, session_id: sid }) + '\n');
  };
  if (['p6-boundary', 'p6-approval', 'p6-guard', 'p6-unknown'].includes(scenario)) {
    const tool = scenario === 'p6-approval' ? { tool_name: 'Bash', tool_input: { command: 'echo FORBIDDEN_MARKER' } }
      : scenario === 'p6-guard' ? { tool_name: 'Write', tool_input: { file_path: '.pi/harness.json', content: '{}' } }
      : { tool_name: 'Write', tool_input: { file_path: 'src/x.ts', content: 'export {}' } };
    const settings = JSON.parse(readFileSync(get('--settings'), 'utf8'));
    const hooks = settings.hooks?.PreToolUse?.flatMap(entry => entry.hooks ?? []) ?? [];
    const results = hooks.map(hook => spawnSync('/bin/sh', ['-c', hook.command], {
      input: JSON.stringify({ ...tool, cwd: process.cwd() }), encoding: 'utf8',
    }));
    const denial = results.find(r => r.status === 2);
    emit(events.find(event => event.subtype === 'init'));
    emit({ type: 'assistant', message: { content: [{ type: 'tool_use', id: 'p6-denied', name: tool.tool_name, input: tool.tool_input }] } });
    if (denial) emit({ type: 'user', message: { content: [{ type: 'tool_result', tool_use_id: 'p6-denied', is_error: true,
      content: 'PreToolUse hook error: ' + (scenario === 'p6-unknown' ? 'legacy error' : denial.stderr) }] } });
    emit({ type: 'result', is_error: false, permission_denials: denial ? [tool] : [], usage: {} });
  } else if (['hang', 'hang-stubborn', 'hang-orphan', 'denial-hang'].includes(scenario)) {
    recordPid();
    if (scenario === 'hang-stubborn') process.on('SIGTERM', () => {});
    if (scenario === 'hang-orphan') {
      spawn(process.execPath, [self, '--hang-orphan-child'], { detached: true, stdio: ['ignore', 'inherit', 'inherit'] }).unref();
    } else if (scenario !== 'denial-hang') spawn(process.execPath, [self, '--hang-child'], { stdio: 'ignore' });
    emit(events.find(event => event.subtype === 'init'));
    if (scenario === 'denial-hang') {
      emit({ type: 'assistant', message: { content: [
        { type: 'tool_use', id: 'denied', name: 'Bash', input: { command: 'codex exec test' } },
      ] } });
      emit({ type: 'user', message: { content: [
        { type: 'tool_result', tool_use_id: 'denied', is_error: true, content: 'PreToolUse hook error: 하네스 가드[승인]: 승인이 필요한 동작입니다 (fixture)' },
      ] } });
    }
    setInterval(() => {}, 1000);
  } else if (['rate-limited', 'stderr-limit', 'rate-limited-text', 'rate-rejected', 'quota-tool'].includes(scenario)) {
    emit(events.find(event => event.subtype === 'init'));
    if (scenario === 'quota-tool') {
      emit({ type: 'assistant', message: { content: [
        { type: 'tool_use', id: 'pending', name: 'Bash', input: { command: 'echo pending' } },
      ] } });
    }
    if (scenario === 'rate-rejected' || scenario === 'quota-tool') {
      emit({ type: 'rate_limit_event', rate_limit_info: { status: 'rejected', overageStatus: 'rejected' } });
      setInterval(() => {}, 1000);
    } else if (scenario === 'rate-limited-text') {
      emit({ type: 'result', is_error: true, result: 'You are out of extra usage. Resets at 10:00.' });
    }
    else if (scenario === 'stderr-limit') process.stderr.write('usage limit reached\n');
    else emit({ type: 'result', is_error: true, api_error_status: 429, permission_denials: [], usage: {} });
    process.exitCode = 1;
  } else {
    // doctor 시험은 재생 결과만 믿지 않고 지정 settings의 실제 훅을 실행한다.
    if (prompt.includes('FODH_DOCTOR_MARKER')) {
      const settings = JSON.parse(readFileSync(get('--settings'), 'utf8'));
      const hooks = settings.hooks?.PreToolUse?.flatMap(entry => entry.hooks ?? []) ?? [];
      const denied = hooks.some(hook => spawnSync('/bin/sh', ['-c', hook.command], {
        input: JSON.stringify({ tool_name: 'Bash', tool_input: { command: 'echo FODH_DOCTOR_MARKER' }, cwd: process.cwd() }),
        encoding: 'utf8',
      }).status === 2);
      const writeInput = { file_path: 'src/FODH_DOCTOR_MARKER.ts', content: 'export {}' };
      const pathDenied = hooks.some(hook => spawnSync('/bin/sh', ['-c', hook.command], {
        input: JSON.stringify({ tool_name: 'Write', tool_input: writeInput, cwd: process.cwd() }), encoding: 'utf8',
      }).status === 2);
      if (!pathDenied) { mkdirSync('src', { recursive: true }); writeFileSync(writeInput.file_path, writeInput.content); }
      emit(events.find(event => event.subtype === 'init'));
      emit({ type: 'assistant', message: { content: [{ type: 'tool_use', id: 'doctor-path', name: 'Write', input: writeInput }] } });
      emit({ type: 'user', message: { content: [{ type: 'tool_result', tool_use_id: 'doctor-path', is_error: pathDenied,
        content: pathDenied ? 'PreToolUse hook error: path denied' : 'fixture write allowed' }] } });
      if (scenario.startsWith('p5-skills-')) {
        let marker;
        try { marker = readFileSync('CLAUDE.md', 'utf8').match(/^- doctor 표식: (FODH-DOC-[a-f0-9]{8})$/m)?.[1]; } catch {}
        emit({ type: 'assistant', message: { content: [{ type: 'text', text: `차단 확인\n${marker ? '문서 확인 ' + marker : '문서 없음'}` }] } });
      }
      if (['doctor-max-turns', 'doctor-max-turns-tool-result'].includes(scenario)) {
        const fixture = new URL('../fixtures/claude-stream-json/doctor-max-turns.jsonl', import.meta.url);
        for (const line of readFileSync(fixture, 'utf8').trim().split('\n')) {
          const event = JSON.parse(line);
          if (!denied && event.type === 'user' && event.message.content[0].tool_use_id === 'doctor-marker') {
            event.message.content[0] = { type: 'tool_result', tool_use_id: 'doctor-marker', is_error: false, content: 'FODH_DOCTOR_MARKER' };
          }
          if (event.type === 'result' && (!denied || scenario === 'doctor-max-turns-tool-result')) event.permission_denials = [];
          emit(event);
        }
        process.exitCode = 1;
      } else {
        emit({ type: 'result', is_error: false, permission_denials: denied
          ? [{ tool_name: 'Bash', tool_input: { command: 'echo FODH_DOCTOR_MARKER' } }, ...(pathDenied ? [{ tool_name: 'Write', tool_input: writeInput }] : [])] : [], usage: {} });
      }
    } else {
      if (scenario === 'ack') {
        const ids = [...prompt.matchAll(/^\[인박스 ([^\]]+)\]/gm)].map(match => match[1]);
        if (!ids.length) throw new Error('ack 시나리오에는 인박스 항목이 필요합니다.');
        const call = args => {
          // 절대 경로를 쓰지 않고 두뇌 자식이 상속한 PATH에서 fodh를 찾는다.
          const result = spawnSync('fodh', args, { encoding: 'utf8', timeout: 5000 });
          if (result.error || result.status !== 0) throw new Error('PATH의 fodh 실행 실패', { cause: result.error });
          return JSON.parse(result.stdout);
        };
        const ack = call(['inbox', 'ack', ...ids]);
        const state = call(['state', 'get']);
        appendFileSync('.pi/fake-ack.jsonl', JSON.stringify({ ids, ack, state }) + '\n');
      }
      if (scenario === 'inherited-pipe') {
        recordPid();
        spawn(process.execPath, [self, '--hang-child'], { stdio: ['ignore', 'inherit', 'inherit'] }).unref();
        await new Promise(resolve => setTimeout(resolve, 150));
      }
      for (const original of events) {
        const event = structuredClone(original);
        if (event.type === 'user') for (const block of event.message?.content ?? []) {
          if (block.type === 'tool_result' && typeof block.content === 'string' && /PreToolUse|hook error/i.test(block.content)) {
            block.content = block.content.replace('하네스 가드:', '하네스 가드[승인]:');
          }
        }
        if (scenario === 'api-key' && event.subtype === 'init') event.apiKeySource = 'ANTHROPIC_API_KEY';
        if (scenario === 'pem-result' && event.type === 'user') {
          for (const block of event.message?.content ?? []) if (block.type === 'tool_result') {
            block.content = '-----BEGIN PRIVATE KEY-----\nnot-a-real-key';
          }
        }
        if (scenario === 'long-result' && event.type === 'user') {
          for (const block of event.message?.content ?? []) if (block.type === 'tool_result') block.content = 'x'.repeat(1000);
        }
        if (scenario === 'iterations' && event.type === 'result') {
          event.usage = { input_tokens: 900000, iterations: [
            { input_tokens: 100, cache_read_input_tokens: 200, cache_creation_input_tokens: 30, output_tokens: 40 },
            { input_tokens: 10, cache_read_input_tokens: 20, cache_creation_input_tokens: 3, output_tokens: 4 },
          ] };
        }
        if (scenario === 'bad-init' && event.subtype === 'init') event.permissionMode = 'default';
        if ((scenario === 'overage' || scenario === 'overage-status') && event.type === 'rate_limit_event') {
          if (scenario === 'overage') event.rate_limit_info.isUsingOverage = true;
          else event.rate_limit_info.overageStatus = 'allowed';
        }
        if (['overage-warning', 'overage-warning-unknown'].includes(scenario) && event.type === 'rate_limit_event') {
          delete event.rate_limit_info.overageStatus;
          delete event.rate_limit_info.overageDisabledReason;
          event.rate_limit_info.status = 'allowed_warning';
          event.rate_limit_info.isUsingOverage = false;
          if (scenario === 'overage-warning-unknown') delete event.rate_limit_info.isUsingOverage;
        }
        emit(event);
      }
      if (scenario === 'eof-before-exit') {
        process.stdout.end();
        await new Promise(resolve => setTimeout(resolve, 150));
        process.stderr.write('EOF 뒤 정상 종료\n');
      }
    }
  }
}
